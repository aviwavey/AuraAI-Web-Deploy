{
  "redirects": [
    {
      "source": "/AuraAI/AuraAI/:path*",
      "destination": "/AuraAI/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/AuraAI/home",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/AuraAI/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/AuraAI/aura-dashboard/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/AuraAI/aura-dashboard/visuals/aura-orb-v001.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/AuraAI/aura-dashboard/visuals/prince-human-v066.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/AuraAI/aura-dashboard/visuals/princess-human-v066.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/AuraAI/aura-dashboard/gods-eye-console/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://aura-ai-current-preview.miketondatraq.chatgpt.site; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/AuraAI/aura-dashboard/gods-eye-console/api/:path*",
      "destination": "/api/gods-eye?path=:path*"
    }
  ],
  "functions": {
    "api/gods-eye.mjs": {
      "maxDuration": 30
    }
  }
}
